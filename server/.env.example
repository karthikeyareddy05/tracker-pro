# Tracker Pro server configuration — placeholders only. Never commit real values.
# Set these in your hosting provider's secret/environment settings (e.g. Render → Environment).

# MongoDB Atlas connection string for a database user with readWrite on the tracker_pro database only.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (default: tracker_pro)
MONGODB_DB_NAME=tracker_pro

# Public https URL of this server; used to build password-reset links (no trailing slash).
APP_BASE_URL=https://your-app.onrender.com

# Resend (https://resend.com) — required for password-reset emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain you verified in Resend, e.g. "Tracker Pro <no-reply@yourdomain.com>".
# For testing only, Resend allows onboarding@resend.dev, which can only send to your own Resend account email.
RESEND_FROM_EMAIL=Tracker Pro <no-reply@yourdomain.com>

# Optional
NODE_ENV=production
PORT=8787
# Number of reverse proxies in front of the server (Render/Railway: 1).
TRUST_PROXY=1
# Extra allowed browser origins, comma-separated (the Android app's origin is allowed by default).
CORS_ORIGINS=
# Directory of the built web app to serve (used by password-reset links opened in a browser).
WEB_DIST_DIR=../app/dist
# Security policy tuning (defaults shown)
LOGIN_MAX_FAILURES=3
LOGIN_LOCKOUT_MINUTES=15
RESET_TOKEN_TTL_MINUTES=30
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
