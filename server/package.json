{
  "name": "tracker-pro-server",
  "version": "1.0.0",
  "private": true,
  "description": "Tracker Pro account and authentication API (Node.js + TypeScript + MongoDB).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:indexes": "node dist/scripts/ensureIndexes.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongodb": "^6.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
