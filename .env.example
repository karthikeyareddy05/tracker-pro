# Tracker Pro — example configuration (placeholders only).
# Server values go in your host's secret settings; see server/.env.example for details.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=tracker_pro
APP_BASE_URL=https://your-app.onrender.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Tracker Pro <no-reply@yourdomain.com>
NODE_ENV=production

# App build (compiled into the APK; not secret). In GitHub Actions use the repository variable API_BASE_URL.
VITE_API_BASE_URL=https://your-app.onrender.com
